{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "desktop": {
      "root": "packages/desktop",
      "framework": "vite"
    },
    "web": {
      "root": "packages/web",
      "framework": "vite",
      "routes": [
        { "handle": "filesystem" },
        { "src": "/(.*)", "dest": "/index.html" }
      ]
    },
    "api": {
      "root": "packages/api"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
